	override void NetworkProcess (ConsoleEvent e)
	{
		if ( e.name.IndexOf("metadoom") != 0 ) return;
		
		Array<string> cmds;
		e.name.Split(cmds, ":");
		
		if ( cmds.Size() < 2 ) return;
		
		let player = players[e.Player];
		
		if ( cmds[1] ~== "swapinv" )
		{
			MetaDoomPlayer(player.mo).SwapInventory();
			return;
		}
		
		if ( cmds[1] ~== "quickmelee" )
		{
			MetaDoomPlayer(player.mo).QuickMelee();
			return;
		}
	}
}