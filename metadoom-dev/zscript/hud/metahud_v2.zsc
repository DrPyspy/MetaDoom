	void DrawArmor()
	{
		if (GetArmorSavePercent() == 50)
		{
			DrawImage("AP2ICON", (27, 180), DI_ITEM_OFFSETS);
		} else {
			DrawImage("APICON", (27, 180), DI_ITEM_OFFSETS);
		}
		DrawString(mSmallFont2, FormatNumber(GetArmorAmount(), 3), (24, 180), DI_ITEM_OFFSETS|DI_TEXT_ALIGN_RIGHT, Font.CR_WHITE);
		
		DrawImage("HUDBAR", (36, 180), DI_ITEM_OFFSETS);
		DrawBar("ARMRBAR", "MTBAR", mArmorInterpolator.GetValue(), 100, (37, 181), 0, SHADER_HORZ, DI_ITEM_OFFSETS);
		if (mArmorInterpolator.GetValue() > 100)
		{
			DrawBar("ARMRBAR2", "MTBAR3", (mArmorInterpolator.GetValue() - 100), 100, (37, 181), 0, SHADER_HORZ, DI_ITEM_OFFSETS);
		}
	}
	
	void DrawKeys(int x, int y)
	{
		int kX = 44;
		int kY = 21;
		
		bool locks[6];
		String icon;
		
		for ( int i = 0; i < 6; i++ )
		{
			bool gotKey = CPlayer.mo.CheckKeys(i + 1, false, true);
			if ( !gotKey ) continue;
			switch (i)
			{
				case 0: icon = "graphics/hud_v2/keys/key_redcard.png"; break;
				case 1: icon = "graphics/hud_v2/keys/key_bluecard.png"; break;
				case 2: icon = "graphics/hud_v2/keys/key_yellowcard.png"; break;
				case 3: icon = "graphics/hud_v2/keys/key_redskull.png"; break;
				case 4: icon = "graphics/hud_v2/keys/key_blueskull.png"; break;
				case 5: icon = "graphics/hud_v2/keys/key_yellowskull.png"; break;
			}
			DrawImage(icon, (x+kX, y+kY), DI_ITEM_OFFSETS);
			kX += 6;
		}
	}
	
	void DrawAmmo (int x, int y)
	{
		string ammoIcon = "AMICON";
		if (CPlayer.ReadyWeapon != null)
		{
			if (CheckWeaponSelected("MetaPistol") && meta_pistolammo == 0)
			{
				ammoIcon = "AMICNBAT";
			} else if (CPlayer.ReadyWeapon.Ammo1 is "Shell")
			{
				ammoIcon = "AMICNSHL";
			} else if (CPlayer.ReadyWeapon.Ammo1 is "RocketAmmo")
			{
				ammoIcon = "AMICNRCK";
			} else if (CPlayer.ReadyWeapon.Ammo1 is "Cell")
			{
				ammoIcon = "AMICNPLS";
			} else if (CPlayer.ReadyWeapon.Ammo1 is "HolyWater")
			{
				ammoIcon = "AMICNWAT";
			} else if (CPlayer.ReadyWeapon.Ammo1 is "HalonCannister")
			{
				ammoIcon = "AMICNEXT";
			} else if (CPlayer.ReadyWeapon.Ammo1 is "BFGAmmo")
			{
				ammoIcon = "AMICNBFG";
			} else if (CPlayer.ReadyWeapon.Ammo1 is "SoulAmmo")
			{
				ammoIcon = "AMICNSOL";
			}/* else if (CPlayer.ReadyWeapon.Ammo1 is "DogGunHealth")
			{
				DrawImage("HPICON", (283, 180), DI_ITEM_OFFSETS);
			} else {
				DrawImage("AMICON", (283, 180), DI_ITEM_OFFSETS);
			}*/
		}
		DrawImage(ammoIcon, (x+2, y+8), DI_ITEM_OFFSETS);
		
		//DrawImage("HUDBAR", (225, 180), DI_ITEM_OFFSETS);
		
		// Draw current ammo amounts
		Ammo ammo1, ammo2;
		int ammomax;
		int ammocount1, ammocount2;
		[ammo1, ammo2, ammocount1, ammocount2] = GetCurrentAmmo();
		
		// Get the maximum ammo of the current weapon, but WITHOUT crashing
		if (ammo1 != NULL)
		{ ammomax = CPlayer.ReadyWeapon.Ammo1.MaxAmount; }
		
		string ammoReadout = ammo1 ? FormatNumber(ammocount1, 3) : "---";
		DrawString(mSmallFont2, ammoReadout, (x+34, y+9), DI_ITEM_OFFSETS|DI_TEXT_ALIGN_RIGHT, Font.CR_WHITE);
		
			/*if (meta_pistolammo == 1 && CheckWeaponSelected("MetaPistol"))
			{
				DrawString(mSmallFont2, FormatNumber(GetAmount("Clip"), 3), (295, 180), DI_ITEM_OFFSETS|DI_TEXT_ALIGN_LEFT, Font.CR_WHITE);
			} else {
				DrawString(mSmallFont2, "---", (295, 180), DI_ITEM_OFFSETS|DI_TEXT_ALIGN_LEFT, Font.CR_WHITE);
			}*/
		DrawBar("graphics/hud_v2/bar_ammobar.png", "graphics/hud_v2/bar_horzbg.png", mAmmoInterpolator.GetValue(), ammomax, (x+36, y+9), 0, SHADER_REVERSE, DI_ITEM_OFFSETS);
		
		int slotX = 85-(7*8);
		int slotY = 0;
		bool found;
		int slot, index;
		if ( CPlayer.ReadyWeapon )
		{
			[found, slot, index] = CPlayer.weapons.LocateWeapon(CPlayer.ReadyWeapon.GetClass());
		}
		
		for ( int i = 0; i <= 7; i++ )
		{
			bool hasInSlot = CPlayer.HasWeaponsInSlot(i+1);
			int textColor = Font.FindFontColor("MetaHudDark");
			if ( i == slot-1 )
			{
				textColor = Font.CR_UNTRANSLATED;
				let tex = TexMan.CheckForTexture("graphics/hud_v2/hud_main.png");
				screen.DrawTexture(tex, false, x+slotX-2, y,
					DTA_SrcX, 201, DTA_SrcY, 170,
					DTA_SrcWidth, 7, DTA_SrcHeight, 8,
					DTA_DestWidth, 7, DTA_DestHeight, 8,
					DTA_320x200, true
					);
			}
			else if ( hasInSlot )
			{
				textColor = Font.FindFontColor("MetaHudGray");
			}
			DrawString(mIndexFont, ""..(i+1), (x+slotX, y+1), DI_TEXT_ALIGN_LEFT|DI_NOSHADOW, textColor);
			slotX += 7;
		}
	}
	
