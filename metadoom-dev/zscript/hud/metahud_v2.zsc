	override void DrawAutomapHUD(double ticFrac)
	{
		// game needs to be checked here, so that SBARINFO also gets the correct colors.
		DrawString(mSmallFont, level.FormatMapName(0), (160, 200-32-8), DI_ITEM_OFFSETS|DI_TEXT_ALIGN_CENTER);
		
		DrawString(mSmallFont, level.TimeFormatted(), ((320+x_off)-4, 2+9), DI_ITEM_OFFSETS|DI_TEXT_ALIGN_RIGHT);
		
		DrawString(mSmallFont, String.Format("Kills: %d/%d", level.killed_monsters, level.total_monsters), ((-x_off)+2, 2), DI_ITEM_OFFSETS|DI_TEXT_ALIGN_LEFT);
		DrawString(mSmallFont, String.Format("Items: %d/%d", level.found_items, level.total_items), ((-x_off)+2, 2+9), DI_ITEM_OFFSETS|DI_TEXT_ALIGN_LEFT);
		DrawString(mSmallFont, String.Format("Secrets: %d/%d", level.found_secrets, level.total_secrets), ((-x_off)+2, 2+18), DI_ITEM_OFFSETS|DI_TEXT_ALIGN_LEFT);
	}

	// Extremely cut down version of the HUD for weirdo althud-havers
	protected void DrawAltBar (double TicFrac)
	{
		if (!CheckInventory("DisableHUD", 1))
		{
			DrawPowerupBars();
		}
	}
	
