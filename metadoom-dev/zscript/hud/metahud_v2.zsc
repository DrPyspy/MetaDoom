/*
----------------------------
MetaDoom
ZScript Definitions
Status Bar
----------------------------
*/

// The HUD! ZScript edition. ZScript HUDs are also nasty, but they're mostly a
// kind of nasty I can deal with. This port wasn't TOO troublesome, probably
// because I got most of the profanity out of the way during JPF.

Class MetaDoom_NotifyMessage
{
	string text;
	int time;
	double prev;
	double y;
}

class MetaDoomStatusBar : BaseStatusBar
{
	HUDFont mHUDFont;
	HUDFont mIndexFont;
	HUDFont mAmountFont;
	InventoryBarState diparms;
	HUDFont mSmallFont;
	HUDFont mSmallFont2;
	HUDFont mTinyFont;
	
	// You need a DynamicValueInterpolator for any value that you want to have interpolated
	DynamicValueInterpolator mHealthInterpolator;
	DynamicValueInterpolator mArmorInterpolator;
	DynamicValueInterpolator mScoreInterpolator;
	DynamicValueInterpolator mAmmoInterpolator;
	
	// Things for the Powerup bar system.
	static const string powerupStuff[] =
	{
		//Name of Powerup Giver - Powerup Icon
		"MetaHasteSphere","POWRPINS",
		"MetaRadSuit","POWRSUIT",
		"MetaLightAmp","POWRLAMP",
		"MetaBerserkTimer","POWRBZRK",
		"MetaQuadDamage","POWRQUAD",
		"BufferLineDONOTEDIT","POWRFART" //This line has to be here for things to work
	};
	int barArraySize; //amount of 'columns' that the array has
	int barArrayColumns; //size of the array divided by the columns
	
	double lowHealthFade;
	
	int x_off;
	
	Array<MetaDoom_NotifyMessage> msg_logs;
	int score_time;
	int score_prev;
	double score_scale;
	double score_scalePrev;
	
	override bool ProcessNotify(EPrintLevel printlevel, String outline)
	{
		if ( printlevel <= PRINT_TEAMCHAT )
		{
			let msg = new("MetaDoom_NotifyMessage");
			msg.text = outline;
			msg.time = 35*4;
			msg_logs.Push(msg);
			if ( msg_logs.Size() > 3 )
			{
				msg_logs.Delete(0);
			}
			return true;
		}
		return false;
	}

	override void Init()
	{
		Super.Init();
		//SetSize(32, 320, 200);
		SetSize(0, 320, 200);

		// Create the fonts used for the HUD
		Font fnt = "HUDFONT_DOOM";
		mHUDFont = HUDFont.Create(fnt, fnt.GetCharWidth("0"), true, 1, 1);
		fnt = "INDEXFONT_DOOM";
		mIndexFont = HUDFont.Create(fnt, fnt.GetCharWidth("0"), true);
		mAmountFont = HUDFont.Create("INDEXFONT");
		//diparms = InventoryBarState.Create();
		diparms = InventoryBarState.Create(mIndexfont, Font.CR_UNTRANSLATED, 1.0, "ARTIBOX", "INVCURS");
		
		mSmallFont = HUDFont.Create("SMALLFONT");
		mSmallFont2 = HUDFont.Create("SMALLFONT2");
		mTinyFont = HUDFont.Create("TINYBABY");
		
		// More Powerup Bar Shit
		barArrayColumns = 2;
		barArraySize = powerupStuff.Size()/barArrayColumns;
		
		// Initialize the interpolation variables
		mHealthInterpolator = DynamicValueInterpolator.Create(0, 0.25, 1, 32);
		mArmorInterpolator = DynamicValueInterpolator.Create(0, 0.25, 1, 32);
		mScoreInterpolator = DynamicValueInterpolator.Create(0, 0.25, 1, 64000);
		mAmmoInterpolator = DynamicValueInterpolator.Create(0, 0.25, 1, 32);
		
		x_off = 53;
	}

	// What happens when a new game begins
	override void NewGame ()
	{
		// Run the parent status bar's NewGame() function
		Super.NewGame();

		// Reset any interpolators that you declared
		mHealthInterpolator.Reset(0);
		mArmorInterpolator.Reset(0);
		mScoreInterpolator.Reset(0);
		mAmmoInterpolator.Reset(0);
	}
	
	// What needs to run every tick
	override void Tick()
	{
		// Run the parent status bar's Tick() function
		Super.Tick();

		// Update the value of the interpolators
		mHealthInterpolator.Update(CPlayer.health); // Set the interpolator's value to this player's health
		mArmorInterpolator.Update(GetArmorAmount());
		mScoreInterpolator.Update(players[consoleplayer].mo.score);
		Ammo ammo1, ammo2;
		int ammomax;
		int ammocount1, ammocount2;
		[ammo1, ammo2, ammocount1, ammocount2] = GetCurrentAmmo();
		mAmmoInterpolator.Update(ammocount1);
		
		if ( CPlayer.health <= 25 )
		{
			lowHealthFade = 1.0;
		}
		else
		{
			if ( lowHealthFade > 0.0 )
			{
				lowHealthFade -= 0.1;
			}
		}
		
		for ( int i = 0; i < msg_logs.Size(); i++ )
		{
			msg_logs[i].time -= 1;
			if ( msg_logs[i].time <= 0 )
			{
				msg_logs.Delete(i);
				i -= 1;
				continue;
			}
			msg_logs[i].prev = msg_logs[i].y;
			int targY = i*9;
			if ( targY >= msg_logs[i].y )
			{
				msg_logs[i].y = targY;
				msg_logs[i].prev = targY;
			}
			else
			{
				msg_logs[i].y = msg_logs[i].y + (targY - msg_logs[i].y) * 0.8;
			}
		}
		
		if ( score_time > 0 )
		{
			score_time -= 1;
		}
		
		if ( mScoreInterpolator.GetValue() > score_prev )
		{
			score_time = 35*4;
			int diff = mScoreInterpolator.GetValue() - score_prev;
			score_scale = min(1.0, diff/1000.0);
		}
		
		score_prev = mScoreInterpolator.GetValue();
		
		score_scalePrev = score_scale;
		score_scale *= 0.75;
	}

	override void Draw (int state, double TicFrac)
	{
		Super.Draw (state, TicFrac);
		
		if ( screenblocks >= 11 )
		{
			return;
		}
		
		let player = MetaDoomPlayer(CPlayer.mo);
		if ( !player ) return;
		
		BeginStatusBar();
		
		if ( lowHealthFade > 0.0 )
		{
			let tex_pulse = TexMan.CheckForTexture("graphics/hud_v2/hurtpulse.png");
			screen.DrawTexture(tex_pulse, false, 0, 0,
				DTA_Alpha, lowHealthFade,
				DTA_DestWidth, Screen.GetWidth(), DTA_DestHeight, Screen.GetHeight());
		}
		
		int y = 170;
		
		let tex = TexMan.CheckForTexture("graphics/hud_v2/hud_main.png");
		screen.DrawTexture(tex, false, -x_off, 0,
			DTA_SrcWidth, 124, DTA_DestWidth, 124,
			DTA_320x200, true
			);
		screen.DrawTexture(tex, false, 320+x_off-110, 0,
			DTA_SrcX, 320-110,
			DTA_SrcWidth, 110, DTA_DestWidth, 110,
			DTA_320x200, true
			);
		screen.DrawTexture(tex, false, 160-32, 0,
			DTA_SrcX, 160-32,
			DTA_SrcWidth, 64, DTA_DestWidth, 64,
			DTA_320x200, true
			);
			
		DrawFaceBox();
		DrawVitals();
		
		int x_right = 320 + x_off - 110;
		int x_left = -x_off;
		
		DrawItemBox(x_left, y);
		DrawKeys(x_left, y);
		DrawScore(x_left, y);
		DrawAmmo(x_right, y);
		DrawReserve(x_right, y);
		
		for ( int i = 0; i < msg_logs.Size(); i++ )
		{
			double alpha = msg_logs[i].time <= 35 ? msg_logs[i].time/35. : 1.0;
			double y = msg_logs[i].prev + (msg_logs[i].y - msg_logs[i].prev) * ticFrac;
			DrawString(mSmallFont, msg_logs[i].text, (x_left+2, 2+floor(y)), DI_ITEM_OFFSETS|DI_TEXT_ALIGN_LEFT, alpha: alpha);
		}
		
		if ( score_time > 0 || automapactive )
		{
			double scalar = score_scalePrev + (score_scale - score_scalePrev) * TicFrac;
			double alpha;
			if ( automapactive )
			{
				alpha = 1.0;
			}
			else
			{
				alpha = score_time <= 35 ? score_time/35. : 1.0;
			}
			int yoff = (score_time >= (4*35)) ? (level.maptime % 2) : 0;
			double flashbert = (level.maptime % 12) / 5.;
			DrawString(mSmallFont, ""..mScoreInterpolator.GetValue(), (320+x_off-4, 2-yoff), DI_ITEM_OFFSETS|DI_TEXT_ALIGN_RIGHT, Font.CR_WHITE, alpha: alpha, scale: (1.0+scalar,1.0+scalar));
			if ( score_time >= 4*35 )
			{
				DrawString(mSmallFont, ""..mScoreInterpolator.GetValue(), (320+x_off-4, 2-yoff), DI_ITEM_OFFSETS|DI_TEXT_ALIGN_RIGHT, Font.FindFontColor("MetaWhite"), alpha: flashbert*0.25, scale: (1.0+scalar,1.0+scalar));
			}
		}
		
		if (isInventoryBarVisible())
		{
			DrawInventoryBar(diparms, (160, 168), 6);
		}
		
		let meleeWeapon = MetaDoomMeleeWeapon(player.weaponSave[1]);
		if ( meleeWeapon )
		{
			DrawString(mAmountFont, ""..meleeWeapon.charges, (x_left+103, y+11), DI_ITEM_OFFSETS|DI_TEXT_ALIGN_RIGHT, Font.CR_WHITE);
			//DrawString(mSmallFont, ""..(100*meleeWeapon.GetChargePercent()).."%", (64, 72), DI_ITEM_OFFSETS|DI_TEXT_ALIGN_LEFT, Font.CR_GOLD);
			DrawBar("graphics/hud_v2/bar_meleebar.png", "", meleeWeapon.charges == meleeWeapon.maxCharges ? meleeWeapon.chargeTime : meleeWeapon.GetChargePercent()*meleeWeapon.chargeTime, meleeWeapon.chargeTime, (x_left+106, y+2), 0, SHADER_VERT|SHADER_REVERSE, DI_ITEM_OFFSETS);
		}
		
		/*if (state == HUD_StatusBar)
		{
			BeginStatusBar();
			DrawMainBar (TicFrac);
		} else if (state == HUD_Fullscreen)	{
			BeginStatusBar();
			DrawMainBar (TicFrac);
		} else if (state == HUD_AltHud) {
			BeginStatusBar();
			DrawAltBar (TicFrac);
		}*/
	}

