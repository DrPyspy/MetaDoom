{
	Default
	{
		-COUNTITEM
		+INVENTORY.ALWAYSPICKUP
		Armor.Savepercent 33.335;
		Armor.Saveamount 4;
		Armor.Maxsaveamount 100;
		Inventory.PickupSound "items/armor/shard";
