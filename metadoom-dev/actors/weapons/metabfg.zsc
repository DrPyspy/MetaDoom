		Radius 13;
		Height 8;
		Speed 25;
		Damage 15;
		BounceType "Classic";
		BounceFactor 1.0;
		Projectile;
		+RANDOMIZE;
		RenderStyle "Add";
		Alpha 0.75;
		Obituary "$OB_MPBFG_MBF";
		Decal "GreenPlasmaScorch";
	}
	States
	{
	Spawn:
		PLS1 A 0 A_PlaySound ("weapons/plasmarifle/loop", CHAN_BODY, 1.0, 1);
		PLS1 AB 6 Bright;
