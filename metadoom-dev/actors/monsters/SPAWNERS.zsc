// These ones need special attention due to +BOSSDEATH handling

class MetaBossSpawner : MetaSpawner
{
	Default
	{
		+NOBLOCKMAP
		+NOSECTOR
		+NOGRAVITY
		+THRUACTORS
	}
	
	override void AfterSpawn(MonsterCore fella)
	{
		fella.bossTracker = MetaBossSpawner(self);
	}

	void StopIt()
	{
		A_BossDeath();
		Destroy();
	}
}

Class BaronOfHellSpawner : MetaBossSpawner // replaces BaronOfHell
{
	override void DoSpawn()
	{
		AddSpawn("MetaBaronOfHell", 1);
	}
}

class ArachnotronSpawner : MetaBossSpawner // replaces Arachnotron
{
	override void DoSpawn()
	{
		int maps = brain.GetMapsCleared();
		
		if ( brain.IsEpisodic() ? (maps >= 6) : (maps >= 20) )
		{
			AddSpawn("MetaSpiborg", 90);
			AddSpawn("MetaTitantula", 64);
		}
		else if ( brain.IsEpisodic() ? (maps >= 4) : (maps >= 8) )
		{
			AddSpawn("MetaSpiborg", 128);
		}
		
		AddSpawn("MetaArachnotron", 128);
	}
}

Class MancubusSpawner : MetaBossSpawner // replaces Fatso
{
	override void DoSpawn()
	{
		int maps = brain.GetMapsCleared();
		
		if ( brain.IsEpisodic() ? (maps >= 7) : (maps >= 16) )
		{
			AddSpawn("MetaBehemoth", 128);
			AddSpawn("MetaCyberManc", 64);
		}
		else if ( brain.IsEpisodic() ? (maps >= 3) : (maps >= 8) )
		{
			AddSpawn("MetaBehemoth", 64);
		}
		
		AddSpawn("MetaMancubus", 128);
	}
}

class CyberdemonSpawner : MetaBossSpawner // replaces Cyberdemon
{
	States
	{
	Spawn:
		CYBR A 0;
		TNT1 A 0 A_JumpIf(meta_uniquebosses == 0, "Cyberdemon");
		TNT1 A 0
		{
			BlockThingsIterator it = BlockThingsIterator.Create(self,32767,0);
			while (it.Next())
			{
				Actor mo = it.thing;
				
				if (mo is "WolfSSSpawner"
				|| mo is "MetaWolfensteinSS"
				|| mo is "MetaWolfensteinSNES"
				|| mo is "MetaWolfensteinApple"
				|| mo is "MetaWolfensteinMacOS"
				|| mo is "MetaWolfensteinJava")
				{
					SetStateLabel("Harbinger");
					break;
				}
			}
		}
	Cyberdemon:
		TNT1 A 0 A_SpawnItemEx("MetaCyberdemon",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_TRANSFERPOINTERS|SXF_TRANSFERAMBUSHFLAG|SXF_TRANSFERSPECIAL|SXF_NOCHECKPOSITION,0,tid);
		goto CreepyStalker;
	Harbinger:
		TNT1 A 0 A_SpawnItemEx("MetaHarbinger",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_TRANSFERPOINTERS|SXF_TRANSFERAMBUSHFLAG|SXF_TRANSFERSPECIAL|SXF_NOCHECKPOSITION,0,tid);
		goto CreepyStalker;
	}
}

// For "Doom 64 for Doom 2"
class CyberdemonSpawner_D64D2 : CyberdemonSpawner
{
	States
	{
