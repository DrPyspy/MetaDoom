/*
----------------------------
MetaDoom
Actor Definitions
Spawners
----------------------------
*/

Class MetaSpawnInfo
{
	Map<String, int> nearby;
	Actor src;
	
	void SearchInRadius(int radius)
	{
		BlockThingsIterator it = BlockThingsIterator.Create(src, radius);
		//Console.Printf("\ck-----");
		while ( it.Next() )
		{
			Actor mo = it.thing;
			
			if ( mo.health <= 0 ) return;
			
			int val = nearby.Get(mo.GetClassName());
			nearby.Insert(mo.GetClassName(), val+1);
			//Console.Printf(""..mo.GetClassName());
		}
	}
	
	bool IsNearby (Class<Actor> thing)
	{
		return nearby.CheckKey(thing.GetClassName());
	}
}

Class MetaSpawner : Actor
{
	Default
	{
		+ISMONSTER
		-COUNTKILL
	}
	
	MetaDoom_GameBrain brain;
	
	MetaSpawnInfo GetNearbyInfo (int searchRadius)
	{
		let spawninfo = new("MetaSpawnInfo");
		spawninfo.src = self;
		spawninfo.SearchInRadius(searchRadius);
		return spawninfo;
	}
	
	Actor SpawnVariant (Class<Actor> toSpawn)
	{
		let newFella = Spawn(toSpawn, pos);
		if ( newFella )
		{
			newFella.SpawnAngle = SpawnAngle;
			newFella.angle = angle;
			newFella.pitch = pitch;
			newFella.roll = roll;
			newFella.SpawnPoint = SpawnPoint;
			newFella.special = special;
			for ( int i = 0; i < 5; i++ )
			{
				newFella.args[i] = args[i];
			}
			newFella.special1 = special1;
			newFella.special2 = special2;
			newFella.SpawnFlags = SpawnFlags & ~MTF_SECRET;
			newFella.HandleSpawnFlags();
			newFella.SpawnFlags = SpawnFlags;
			newFella.bCountSecret = SpawnFlags & MTF_SECRET;
			newFella.ChangeTid(tid);
			newFella.vel = vel;
			newFella.master = master;
			newFella.target = target;
			newFella.tracer = tracer;
			newFella.CopyFriendliness(self, false);
			if ( health != SpawnHealth() ) newFella.health = health;
		}
		
		return newFella;
	}
	
	Array< Class<Actor> > spawns_class;
	Array<int> spawns_weight;
	
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		brain = MetaDoom_GameBrain.Get();
		DoSpawn();
		int totalWeight;
		//Console.Printf("=========================");
		for ( int i = 0; i < spawns_weight.Size(); i++ )
		{
			//Console.Printf("\t%s - %d", spawns_class[i].GetClassName(), spawns_weight[i]);
			totalWeight += spawns_weight[i];
		}
		//Console.Printf("------");
		int randomWeight = random(0,totalWeight);
		for ( int i = 0; i < spawns_class.Size(); i++ )
		{
			if ( randomWeight < spawns_weight[i] )
			{
				let fella = SpawnVariant(spawns_class[i]);
				AfterSpawn(MonsterCore(fella));
				//Console.Printf("\tSpawned %s at %f %f %f", spawns_class[i].GetClassName(), fella.pos.x, fella.pos.y, fella.pos.z);
				return;
			}
			randomWeight -= spawns_weight[i];
		}
	}
	
	virtual void AfterSpawn(MonsterCore fella)
	{
		Destroy();
	}
	
	void AddSpawn(Class<Actor> toSpawn, int weight)
	{
		spawns_class.Push(toSpawn);
		spawns_weight.Push(weight);
	}
	
	virtual void DoSpawn()
	{
	}
}

Class ZombiemanSpawner : MetaSpawner // replaces ZombieMan
{
	override void DoSpawn()
	{
		if ( meta_contentlocust )
		{
			AddSpawn("MetaZombieman", 128);
			AddSpawn("MetaHellRazer", 128);
		}
		
		int maps = brain.GetMapsCleared();
		
		if ( brain.IsEpisodic() ? (maps >= 2) : (maps >= 5) )
		{
			AddSpawn("MetaHellRazer", 128);
		}
		AddSpawn("MetaZombieman", 128);
	}
}

