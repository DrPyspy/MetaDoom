		TNT1 A 1;
		TNT1 A 1 A_KeenDie;
		Stop;
	}
}



class SpiderMastermindSpawner : MetaBossSpawner // replaces SpiderMastermind
{
	States
	{
	Spawn:
		SPID A 0;
		TNT1 A 0 A_JumpIf(meta_uniquebosses == 0, "SpiderMastermind");
		TNT1 A 0
		{
			if(level.MapName ~== "e4m8")
			{
				return ResolveState("MotherDemon");
			} else if(level.MapName ~== "map28") {
				return ResolveState("HellGuard");
			} else {
				return ResolveState("SpiderMastermind");
			}
		}
	SpiderMastermind:
		TNT1 A 0 A_SpawnItemEx("MetaSpiderMastermind",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_TRANSFERPOINTERS|SXF_TRANSFERAMBUSHFLAG|SXF_TRANSFERSPECIAL|SXF_NOCHECKPOSITION,0,tid);
		goto CreepyStalker;
	MotherDemon:
		TNT1 A 0 A_SpawnItemEx("MetaMotherDemon",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_TRANSFERPOINTERS|SXF_TRANSFERAMBUSHFLAG|SXF_TRANSFERSPECIAL|SXF_NOCHECKPOSITION,0,tid);
		goto CreepyStalker;
	HellGuard:
		TNT1 A 0 A_SpawnItemEx("MetaHellGuard",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_TRANSFERPOINTERS|SXF_TRANSFERAMBUSHFLAG|SXF_TRANSFERSPECIAL|SXF_NOCHECKPOSITION,0,tid);
		goto CreepyStalker;
	}
}

