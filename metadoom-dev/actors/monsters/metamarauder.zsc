	}
}

Class MetaMarauder_AfterImage : VisualThinker
{
	double fade;
	
	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		SetRenderStyle(STYLE_AddStencil);
		alpha = 0.25;
		flags = SPF_FULLBRIGHT;
		fade = 0.25;
		scolor = "#FF0000";
	}
	
	static void Spawn(Actor owner)
	{
		if (!owner) return;
		
		let p = Level.SpawnVisualThinker("MetaMarauder_AfterImage");
		if ( p )
		{
			p.pos = owner.pos;
			p.texture = owner.CurState.GetSpriteTexture(0);
		}
	}
	
	override void Tick()
	{
		if ( bDESTROYED )
			return;
	
		super.Tick();
		
		fade -= 0.025;
		
		if ( fade <= 0.0 )
		{
			Destroy();
			return;
		}
		
		alpha = max(0.0, fade + frandom(-0.1,0.1));
	}
}